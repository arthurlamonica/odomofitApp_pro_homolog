# Exemplo de configuração de Keystore para assinatura do Android App Bundle (.aab)
# Copie este arquivo para 'keystore.properties' (na pasta android/) e preencha com seus dados reais.
# NUNCA commite seu keystore.properties nem o arquivo .jks / .keystore no repositório!

keyAlias=odomofit-key
keyPassword=sua_senha_da_chave
storeFile=release-key.jks
storePassword=sua_senha_da_keystore
